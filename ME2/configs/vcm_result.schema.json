{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCM result",
  "type": "object",
  "required": ["decision", "intent", "intent_confidence", "slots"],
  "properties": {
    "decision": {"enum": ["execute", "low_confidence", "unsupported"]},
    "intent": {
      "type": ["string", "null"],
      "enum": [
        "PLAY_MUSIC", "WEATHER", "TIME", "LIGHT_ON", "LIGHT_OFF",
        "PAUSE", "STOP", "NEXT", "VOLUME_UP", "VOLUME_DOWN", "CALL",
        "MESSAGE", "LIST_REMINDERS", "TIMER", "ALARM", "TEMPERATURE",
        "BRIGHTNESS", "COLOR", "CREATE_REMINDER", null
      ]
    },
    "intent_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "in_scope_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "slots": {"type": "object"},
    "slot_confidences": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    }
  },
  "additionalProperties": false
}

